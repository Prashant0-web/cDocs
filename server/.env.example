NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=https://cdocs.prashantbuilds.com

# MongoDB Connection String (Atlas URI in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cdocs?retryWrites=true&w=majority
# Or CONNECTION_URI=mongodb://...

# Security
JWT_SECRET=your_jwt_secret_key_here

# Email / OTP Service (Gmail App Password)
ORG_NAME=cDocs
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=question-papers
R2_PUBLIC_DOMAIN=https://your-public-r2-domain.r2.dev

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
